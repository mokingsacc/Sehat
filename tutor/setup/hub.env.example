# Settings for one village hub. install.sh copies this to /etc/qalam/hub.env; edit that copy, then
#   sudo systemctl restart tutor-hub
# Never put this file in the repository once it holds a real Wi-Fi password.

# The name shown in the app and on every sheet (a working name until the real one is chosen)
TUTOR_NAME=Qalam
# Where the hub keeps its database, teacher PIN and print outbox
TUTOR_DATA=/var/lib/qalam
TUTOR_PACKS=/opt/qalam/tutor/content/packs
TUTOR_APP=/opt/qalam/tutor/app

# The address phones open (the hotspot's own address; qalam.lan also works on the hotspot)
TUTOR_PUBLIC_URL=http://10.42.0.1
# For the join-the-Wi-Fi QR code on the printed hub card
TUTOR_WIFI_SSID=Qalam
TUTOR_WIFI_PASSWORD=change-me-please

# The AI (optional). Leave TUTOR_LLM_URL empty and the hub still answers from checked answers, lessons and the teacher.
TUTOR_LLM_URL=http://127.0.0.1:8081/v1
TUTOR_LLM_MODEL=local
# Languages the AI may answer in. Pashto joins only after it passes the Pashto question set (docs/ROADMAP.md).
TUTOR_AI_LANGS=prs,en
TUTOR_LLM_TIMEOUT=60
# Who answers: local (the model server above; the default when TUTOR_LLM_URL is set), off, or fake (tests only).
# The hub refuses to start with any other provider or host.
TUTOR_AI_PROVIDER=local
# AI tokens the hub's cohort may use per day (UTC); after that, checked answers, lessons and the teacher. Empty = no cap.
TUTOR_AI_BUDGET=300000

# Printing: auto (CUPS if installed), cups, or outbox (PDFs saved in TUTOR_DATA/outbox for the teacher to print)
TUTOR_PRINT=auto
# A CUPS printer name; empty means the system's default printer
TUTOR_PRINTER=
# More copies than this need the teacher's PIN; each phone may print this many copies an hour
TUTOR_FREE_COPIES=3
TUTOR_COPIES_PER_HOUR=12

# Questions are deleted after this many days (answers the teacher approved are kept)
TUTOR_KEEP_DAYS=60
